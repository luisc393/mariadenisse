---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { slugTema, libroEN } from '../../../data/sitio';
import { fechaEN, temasEN } from '../../../data/i18n';
import { articlesEN, type ArticleEN } from '../../../data/articulosEN';

export async function getStaticPaths() {
  const lista = (await articlesEN()).reverse(); // oldest first
  return lista.map((article, i) => ({
    params: { id: article.id },
    props: { article, anterior: lista[i - 1], siguiente: lista[i + 1] },
  }));
}

interface Props { article: ArticleEN; anterior?: ArticleEN; siguiente?: ArticleEN }
const { article, anterior, siguiente } = Astro.props;
const { Content } = await render(article.en);
const d = article.es.data;
const tema = d.tema ? temasEN[d.tema] : undefined;
const resumen = (article.en.body ?? '').replace(/\\([*_.#])/g, '$1').replace(/_/g, '').split(/\n\s*\n/)[0]?.slice(0, 160) ?? '';
---
<Base lang="en" titulo={article.en.data.title} descripcion={resumen} alterna={`/articulos/${article.id}`}>
  <article>
    <header class="cabeza-articulo lectura">
      <p class="etiqueta">{tema ? <a href={`/en/articles?tema=${slugTema(d.tema!)}`}>{tema}</a> : 'Article'}</p>
      <h1>{article.en.data.title}</h1>
      <p class="meta">María Denisse Fanianos de Capriles · {[d.medio, fechaEN(d)].filter(Boolean).join(', ')}</p>
      <hr class="linea" />
    </header>
    <div class="lectura articulo">
      <Content />
    </div>
    <footer class="lectura pie-articulo">
      {article.en.data.libroEN ? (
        <p class="caja-libro">
          This article is part of the book <a href="/en/book"><em>{libroEN.titulo}</em></a>.
        </p>
      ) : (
        <p class="nota">Translated from the Spanish. <a href={`/articulos/${article.id}`} lang="es">Leer el original en español</a>.</p>
      )}
      <nav class="navegacion" aria-label="More articles">
        {anterior ? <a href={`/en/articles/${anterior.id}`}><small>← Previous</small>{anterior.en.data.title}</a> : <span></span>}
        {siguiente ? <a href={`/en/articles/${siguiente.id}`} class="der"><small>Next →</small>{siguiente.en.data.title}</a> : <span></span>}
      </nav>
      <p><a href="/en/articles">Back to all articles</a></p>
    </footer>
  </article>
</Base>

<style>
  .etiqueta a { color: var(--oro); text-decoration: none; }
  .pie-articulo { margin-top: 24px; }
  .caja-libro { background: var(--blanco); border: 1px solid var(--borde); border-left: 3px solid var(--oro); padding: 14px 18px; }
  .navegacion { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 32px 0 16px; border-top: 1px solid var(--borde); padding-top: 20px; }
  .navegacion a { text-decoration: none; font-family: var(--serif); font-size: 1.05rem; }
  .navegacion small { display: block; font-family: var(--sans); color: var(--gris); font-size: .8rem; margin-bottom: 2px; }
  .navegacion .der { text-align: right; }
  @media (max-width: 560px) { .navegacion { grid-template-columns: 1fr; } .navegacion .der { text-align: left; } }
</style>
