---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import BotonesCompra from '../../components/BotonesCompra.astro';
import { libroEN } from '../../data/sitio';
import cover from '../../assets/cover-en.jpg';
---
<Base lang="en" titulo={libroEN.titulo} descripcion={`${libroEN.titulo} ${libroEN.subtitulo}. A book by Venezuelan journalist María Denisse Fanianos de Capriles.`}>
  <section class="seccion blanca">
    <div class="contenedor libro-grid">
      <Image src={cover} alt="Cover of Can You Be Happy in Venezuela?" widths={[280, 420, 560]} sizes="(max-width: 760px) 70vw, 340px" class="portada" loading="eager" />
      <div>
        <p class="etiqueta">The book</p>
        <h1>{libroEN.titulo}</h1>
        <p class="intro"><em>{libroEN.subtitulo}</em></p>
        <hr class="linea" />
        <p>
          Many people say that it is impossible to be happy in Venezuela, given the hundreds of problems its people face
          every day. And yet millions of Venezuelans have shown remarkable patience, strength, creativity, hard work and joy.
        </p>
        <p>
          This book answers the question with a clear «yes», backed by real stories. It gathers the weekly columns that
          journalist María Denisse Fanianos de Capriles wrote for the Venezuelan newspaper <em>El Universal</em> between
          2011 and 2015: hard moments that many families faced with faith, hope and a positive outlook.
        </p>
        <p>
          A book about joy, solidarity, service and hope, written by a mother of six who decided to stay in her country.
        </p>
        <h2 class="h-compra">Buy the book</h2>
        <BotonesCompra enlaces={libroEN.compra} aviso="Purchase links coming soon." />
        <dl class="ficha">
          <div><dt>Publisher</dt><dd>{libroEN.editorial}</dd></div>
          <div><dt>ISBN</dt><dd>{libroEN.isbn}</dd></div>
          <div><dt>Original edition</dt><dd><a href="/libro" lang="es">¿Se puede ser feliz en Venezuela?</a></dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor" style="max-width:760px">
      <p class="etiqueta">About the author</p>
      <h2>María Denisse Fanianos de Capriles</h2>
      <p>
        Venezuelan journalist, writer and opinion columnist, wife and mother of six. She graduated first in her class from
        the School of Social Communication at the Central University of Venezuela (1989). From 2011 she wrote a weekly
        column for <em>El Universal</em>, and her pieces were republished by ACI Prensa and other international outlets.
        In 1994 she co-founded Fundación Entre Líneas, which published the free monthly bulletin <em>Leer Entre Líneas</em>.
      </p>
      <p><a href="/sobre-ella" lang="es">Biografía completa en español →</a></p>
    </div>
  </section>
</Base>

<style>
  .libro-grid { display: grid; grid-template-columns: 340px 1fr; gap: 56px; align-items: start; }
  .portada { box-shadow: 0 20px 40px -18px rgba(0,0,0,.45); border-radius: 2px; }
  .h-compra { font-size: 1.3rem; margin-top: 28px; }
  .ficha { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; margin: 28px 0 0; padding: 16px 0 0; border-top: 1px solid var(--borde); }
  .ficha dt { font-size: .78rem; text-transform: uppercase; letter-spacing: .1em; color: var(--gris); }
  .ficha dd { margin: 2px 0 0; font-weight: 600; }
  @media (max-width: 760px) {
    .libro-grid { grid-template-columns: 1fr; gap: 24px; }
    .portada { max-width: 240px; }
  }
</style>
